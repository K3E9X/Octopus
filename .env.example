# Octopus Leak — EVERY value here is OPTIONAL.
# Copy to .env.local (dev) or set as container / Vercel env vars. The app always runs
# and says what is missing rather than faking it.

# --- LeakOSINT — THE source. Nothing else queries anything. ---
# Get a token from the bot's /api command. A new token carries 100 free requests; after
# that it draws on the account balance. It bills per request, so keep it secret: set it
# here or in the platform's environment, never in code.
# Format looks like  123456789:AbCdEf12
# Absent → no leak data, and the product SAYS so. It never returns an empty report.
LEAKOSINT_TOKEN=

# Rows per query, 100–10000 (default 100). This is a DEPTH control, not a page size: it
# decides how far into the databases a search reaches, and it is a price multiplier.
# See docs/leakosint-api.md for the formula.
# LEAKOSINT_LIMIT=100

# Language of the per-database breach descriptions (default en).
# LEAKOSINT_LANG=en

# LEAKOSINT_URL=https://leakosintapi.com/

# --- Accounts, credits and the audit trail ---
# Present → accounts exist, searches are metered against a balance, and every query is
#           written to the append-only hash-chained log.
# Absent  → SINGLE-OPERATOR: the tool runs open, unmetered and UNLOGGED. That is fine
#           for one analyst on a laptop and is not fine for anything reachable from the
#           internet. Anyone exposing an instance publicly needs this set.
POSTGRES_URL=
# DATABASE_URL=         # read as a fallback, in that order
# NEON_DATABASE_URL=    # likewise
#
# The driver is chosen from the host: a neon.tech URL uses Neon's HTTP client, anything
# else gets a normal pooled TCP connection, so a Postgres you run yourself works.
# PGPOOL_MAX=5          # connections in the TCP pool

# Session signing key. A missing secret is NOT replaced by a constant — that would let
# every deployment forge every other one's sessions — so sessions are refused instead.
# Generate with:  openssl rand -hex 32
OCTOPUS_SESSION_SECRET=
# AUTH_SECRET=          # read as a fallback for the line above

# Key for the audit chain's HMAC. Falls back to the session secret, which is usually
# what you want; set it separately only if the two should rotate independently.
# Without either, the chain is unkeyed — anyone who can write to the database can
# edit a row and recompute every hash after it. The admin screen says when that is so.
# OCTOPUS_AUDIT_SECRET=

# --- What a credit is worth ---
# A credit is ONE SEARCH. This sets its dollar VALUATION, as a multiple of what the
# query costs upstream — the figure quoted beside a price, and the rate a grant made in
# dollars converts at. It is NOT the margin and cannot change a credit price: a
# three-word name costs four credits because it is four times the work, whatever margin
# you take. The margin is what you sell a pack of credits for. Default 1.6, bounded 1–1000.
# OCTOPUS_MARKUP=1.6

# The most an `admin` may move in one grant. An owner is not bounded. Creating credit
# spends YOUR upstream balance, so it is the owner's power; an admin passes some on,
# to somebody else, within this. Default 500.
# OCTOPUS_ADMIN_GRANT_MAX=500

# Free searches a new account starts with. Blank or junk falls back to 2 — an empty
# value used to read as zero and silently turn the trial off. Capped at 10000.
# OCTOPUS_TRIAL_SEARCHES=2

# An explicit dollar welcome balance, if you prefer to set one; it overrides the
# search count above. Registration is open, so whatever you put here is handed to
# anyone who signs up — set it only behind registration you control.
# OCTOPUS_STARTER_USD=
