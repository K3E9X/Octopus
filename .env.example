# Octopus configuration — EVERY value here is OPTIONAL.
# Copy to .env.local (dev) or set as container / Vercel env vars. Leave a line empty
# to keep that feature off; the app always runs and degrades gracefully.

# --- Deep-scan collector worker (Maigret / Holehe / SpiderFoot) ---
# Present  → the "Maigret (deep)", Holehe, SpiderFoot apps light up.
# Absent   → built-in keyless connectors only.
COLLECTOR_URL=
COLLECTOR_TOKEN=

# --- Durable storage (cases + append-only snapshot history / chain of custody) ---
# Present  → cases persist server-side across devices and restarts.
# Absent   → cases fall back to the browser (localStorage).
POSTGRES_URL=

# --- Breach / leak search (Intelligence X) — optional, sensitive ---
INTELX_API_KEY=
# INTELX_URL=https://2.intelx.io

# --- BONUS: Recorded Future (enterprise) — optional, never a base source ---
# Present  → adds credential-exposure (email) + risk (domain) enrichment.
# Absent   → silently skipped. Safe to remove any time.
RECORDED_FUTURE_API_KEY=
# RF_API_URL=https://api.recordedfuture.com/v2
# RF_IDENTITY_URL=https://api.recordedfuture.com/identity

# --- LLM: grounded synthesis + investigative assistant (OpenAI-compatible) ---
# You can set these here, OR enter them in the app's API panel (stored in your browser).
# Free providers: OpenRouter (many :free models — deepseek/qwen), z.ai GLM-4-Flash,
# Qwen/DashScope, Groq (fast free tier), or local Ollama (no key). Web search works on
# OpenRouter via a ":online" model suffix (toggle in the API panel).
# Absent → SYNTHESIZE / the assistant say "not configured"; everything else works.
LLM_API_URL=          # e.g. https://openrouter.ai/api/v1
LLM_MODEL=            # e.g. deepseek/deepseek-chat-v3.1:free
LLM_API_KEY=

# --- OPSEC egress: proxy / Tor ---
# socks5:// routes collection through SOCKS (Tor's SOCKS port is 9050, Tor Browser's
# is 9150). This is what makes .onion reachable — an http:// proxy CANNOT reach hidden
# services. Hostnames are always resolved AT the proxy, so no DNS lookup leaks the
# target. If a proxy is set and cannot be used, requests are BLOCKED, never sent direct.
# Can also be set per-case in the app's API panel.
OCTOPUS_PROXY=        # e.g. socks5://127.0.0.1:9050
OCTOPUS_POSTURE=      # direct | careful | no-touch
OCTOPUS_CASE_ID=      # anchors the egress fingerprint so cases are not correlatable

# --- Darkweb: onion search engines ---
# Comma-separated `Name=url-with-{q}`. Overrides the built-ins (Ahmia clearnet + onion
# mirror, Torch, Haystak) — onion addresses rot constantly, so this is the escape hatch
# when one moves. Entries on .onion are used only when OCTOPUS_PROXY is a SOCKS proxy.
OCTOPUS_ONION_ENGINES=
