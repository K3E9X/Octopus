# Octopus Leak — EVERY value here is OPTIONAL.
# Copy to .env.local (dev) or set as container / Vercel env vars. The app always runs
# and says what is missing rather than faking it.

# --- LeakOSINT — THE source. Nothing else queries anything. ---
# Get a token from the bot's /api command. A new token carries 100 free requests; after
# that it draws on the account balance. It bills per request, so keep it secret: set it
# here or in the platform's environment, never in code.
# Format looks like  123456789:AbCdEf12
# Absent → no leak data, and the product SAYS so. It never returns an empty report.
LEAKOSINT_TOKEN=

# Rows per query, 100–10000 (default 100). This is a DEPTH control, not a page size: it
# decides how far into the databases a search reaches, and it is a price multiplier.
# See docs/leakosint-api.md for the formula.
# LEAKOSINT_LIMIT=100

# Language of the per-database breach descriptions (default en).
# LEAKOSINT_LANG=en

# LEAKOSINT_URL=https://leakosintapi.com/

# --- Accounts, credits and the audit trail ---
# Present → accounts exist, searches are metered against a balance, and every query is
#           written to the append-only hash-chained log.
# Absent  → SINGLE-OPERATOR: the tool runs open, unmetered and UNLOGGED. That is fine
#           for one analyst on a laptop and is not fine for anything reachable from the
#           internet. Anyone exposing an instance publicly needs this set.
POSTGRES_URL=

# Session signing key. A missing secret is NOT replaced by a constant — that would let
# every deployment forge every other one's sessions — so sessions are refused instead.
# Generate with:  openssl rand -hex 32
OCTOPUS_SESSION_SECRET=

# --- The margin ---
# Resale markup over the raw API cost, applied once so the quote the operator sees and
# the amount debited can never disagree. Default 1.6.
# OCTOPUS_MARKUP=1.6

# Welcome balance for a new account, in dollars, so a first search needs no admin
# round-trip. Default 0.5.
# OCTOPUS_STARTER_USD=0.5
